# Copy this file to .env and adjust if your WAMP MySQL settings differ.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crictalentai_db

# Used to sign JWT login tokens. Change this to any long random string.
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins (React dev server).
CORS_ORIGINS=http://localhost:5173
